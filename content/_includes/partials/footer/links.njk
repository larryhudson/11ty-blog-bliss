<div class="links">
  {% if homepage %}
  <ul>
    {% for item in siteConfig.metaPages | reverse %}
    <li>
      <a href="{{ item.url }}"><span>{{ item.title }}</span></a>
    </li>
    {% endfor %}
    <li>
      <a href="/archive/"><span>Blog archive</span></a>
    </li>
  </ul>
  {% else %}
  {% include "partials/footer/nav-pages.njk" %}    
  {% include "partials/footer/meta-pages.njk" %}
  {% endif %}
</div>
